# Copy to .env locally; never commit credentials.
# Empty key or model name keeps the app in local evidence mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT=90
# PyMuPDF supports text-layer PDFs; OCR is not included.
EVIDENCE_PARSER=pymupdf
# Default ./data; keep database and files together when moving the project.
# EVIDENCELAB_DATA_DIR=
